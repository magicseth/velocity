{
  "manifest_version": 3,
  "name": "Velocity \u2014 Tidy Tabs",
  "version": "0.1.0",
  "minimum_chrome_version": "121",
  "description": "Organize related tabs, review stale tabs, and clean up exact duplicates within this Chrome profile.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Organize tabs with Velocity",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "incognito": "not_allowed",
  "key": ""
}
